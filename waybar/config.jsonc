{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 4,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,

    "modules-left": [
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "pulseaudio",
        "backlight",
        "network",
        "cpu",
        "memory",
        "temperature",
        "battery",
        "tray",
        "custom/power"
    ],

    // ── Workspaces ──────────────────────────────────────────────
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "①",
            "2": "②",
            "3": "③",
            "4": "④",
            "5": "⑤",
            "6": "⑥",
            "7": "⑦",
            "8": "⑧",
            "9": "⑨",
            "urgent": "",
            "active": "",
            "default": ""
        },
        "persistent-workspaces": {
            "*": [1, 2, 3, 4, 5]
        },
        "on-click": "activate"
    },

    // ── Active window ────────────────────────────────────────────
    "hyprland/window": {
        "format": "{}",
        "max-length": 50,
        "separate-outputs": true
    },

    // ── Clock ────────────────────────────────────────────────────
    "clock": {
        "format": " {:%a %d %b  %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "interval": 60
    },

    // ── CPU ──────────────────────────────────────────────────────
    "cpu": {
        "format": "󰍛 CPU {usage}%",
        "interval": 3,
        "tooltip-format": "CPU Usage: {usage}%\nLoad: {load}"
    },

    // ── Memory ───────────────────────────────────────────────────
    "memory": {
        "format": " RAM {used:0.1f}G/{total:0.1f}G",
        "interval": 5,
        "tooltip-format": "Used: {used:0.2f}G\nAvailable: {avail:0.2f}G\nTotal: {total:0.2f}G"
    },

    // ── Temperature ──────────────────────────────────────────────
    "temperature": {
        "critical-threshold": 80,
        "format": " TEMP {temperatureC}°C",
        "format-critical": " TEMP {temperatureC}°C",
        "tooltip": true
    },

    // ── Network — Kali style with upload/download speeds ─────────
    "network": {
        "interval": 2,
        "format-wifi": " {essid}  {bandwidthUpBytes}  {bandwidthDownBytes}",
        "format-ethernet": "󰈀 {ipaddr}  {bandwidthUpBytes}  {bandwidthDownBytes}",
        "format-linked": "󰈀 No IP",
        "format-disconnected": "󰖪 Disconnected",
        "tooltip-format-wifi": "SSID: {essid}\nSignal: {signalStrength}%\nIP: {ipaddr}/{cidr}\nGateway: {gwaddr}",
        "tooltip-format-ethernet": "Interface: {ifname}\nIP: {ipaddr}/{cidr}\nGateway: {gwaddr}",
        "on-click": "kitty -e nmtui-dark"
    },

    // ── Backlight ─────────────────────────────────────────────────
    "backlight": {
        "device": "amdgpu_bl1",
        "format": "󰃟 BRIGHT {percent}%",
        "scroll-step": 5,
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-",
        "tooltip": false
    },

    // ── Audio ────────────────────────────────────────────────────
    "pulseaudio": {
        "format": "󰕾 VOL {volume}%",
        "format-muted": "󰖁 MUTED",
        "format-icons": {
            "headphone": "󰋋",
            "headset": "󰋎",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol",
        "scroll-step": 5,
        "tooltip-format": "Volume: {volume}%\nDevice: {desc}"
    },

    // ── Battery ──────────────────────────────────────────────────
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} BAT {capacity}%",
        "format-charging": "󰂄 CHR {capacity}%",
        "format-plugged": "󰚥 FULL {capacity}%",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "Status: {timeTo}\nCycles: {cycles}\nHealth: {health}%"
    },

    // ── System tray ──────────────────────────────────────────────
    "tray": {
        "spacing": 8,
        "icon-size": 16
    },

    // ── Power button ─────────────────────────────────────────────
    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "wlogout --layout ~/.config/wlogout/layout --css ~/.config/wlogout/style.css --buttons-per-row 3 --column-spacing 10 --row-spacing 10 --margin-top 300 --margin-bottom 300 --margin-left 400 --margin-right 400"
    }
}
